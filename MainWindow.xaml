<Window x:Class="RonekaiImageFramer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RonekaiImageFramer.Controls"
        Title="PhonixFrame — Görsel Stüdyo"
        Height="920" Width="1400"
        MinHeight="760" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BrandLightBrush}"
        Loaded="MainWindow_Loaded"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2.2*" MinHeight="360"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*" MinHeight="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık (kompakt) -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:BrandingHeaderView x:Name="BrandingHeader" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="ImageCountText"
                       VerticalAlignment="Center" FontSize="12" Margin="12,0,10,0"
                       Foreground="{StaticResource BrandMutedBrush}"/>
            <controls:BrandingSettingsButton x:Name="BrandingSettings" Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>

        <!-- Üst: Önizleme sahnesi (ekranın büyük kısmı) + Günlük -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="10"
                    Padding="8,6,8,6" BorderBrush="#E2E6ED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="280"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Araç çubuğu + kırp ayarları -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Canlı önizleme" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="PreviewModeBadge" Background="#1B2A4A" CornerRadius="4"
                                        Padding="8,3" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock x:Name="PreviewModeBadgeText" Text="DEMO" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                </Border>
                                <ComboBox x:Name="FiligramCleanStyleCombo" Width="138" Height="26"
                                          Margin="12,0,4,0" VerticalAlignment="Center"
                                          ToolTip="Filigram temizleme stili"/>
                                <Border BorderBrush="#C5CAD3" BorderThickness="1" CornerRadius="5"
                                        Background="#F4F6F9" Padding="3,2" Margin="8,0,6,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Kesit şekli — Normal = varsayılan seçim">
                                    <StackPanel x:Name="BrushShapeBar" Orientation="Horizontal">
                                        <RadioButton x:Name="ShapeNormalRadio" GroupName="BrushShapeGroup"
                                                     IsChecked="True" Width="34" Height="26" Margin="1,0"
                                                     ToolTip="Normal — varsayılan seçim"
                                                     Checked="BrushShapeRadio_Checked" Tag="Normal">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                                            BorderBrush="#9AA3B2" BorderThickness="1" Padding="2">
                                                        <TextBlock Text="N" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="#3D4654" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1B2A4A"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF1F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton x:Name="ShapeCircleRadio" GroupName="BrushShapeGroup"
                                                     Width="34" Height="26" Margin="1,0"
                                                     ToolTip="Daire"
                                                     Checked="BrushShapeRadio_Checked" Tag="Circle">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                                            BorderBrush="#9AA3B2" BorderThickness="1" Padding="4">
                                                        <Ellipse Stroke="#1B2A4A" StrokeThickness="1.25" Fill="Transparent"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1B2A4A"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF1F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton x:Name="ShapeSquareRadio" GroupName="BrushShapeGroup"
                                                     Width="34" Height="26" Margin="1,0"
                                                     ToolTip="Kare"
                                                     Checked="BrushShapeRadio_Checked" Tag="Square">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                                            BorderBrush="#9AA3B2" BorderThickness="1" Padding="5">
                                                        <Rectangle Stroke="#1B2A4A" StrokeThickness="1.25" Fill="Transparent"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1B2A4A"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF1F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton x:Name="ShapeSoftSquareRadio" GroupName="BrushShapeGroup"
                                                     Width="34" Height="26" Margin="1,0"
                                                     ToolTip="Yumuşak kare"
                                                     Checked="BrushShapeRadio_Checked" Tag="SoftSquare">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                                            BorderBrush="#9AA3B2" BorderThickness="1" Padding="5">
                                                        <Rectangle Stroke="#1B2A4A" StrokeThickness="1.25" Fill="Transparent"
                                                                   RadiusX="4" RadiusY="4"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1B2A4A"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF1F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                        <RadioButton x:Name="ShapeEllipseRadio" GroupName="BrushShapeGroup"
                                                     Width="34" Height="26" Margin="1,0"
                                                     ToolTip="Elips"
                                                     Checked="BrushShapeRadio_Checked" Tag="Ellipse">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3"
                                                            BorderBrush="#9AA3B2" BorderThickness="1" Padding="3,6">
                                                        <Ellipse Stroke="#1B2A4A" StrokeThickness="1.25" Fill="Transparent"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1B2A4A"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#EEF1F6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Boyut" VerticalAlignment="Center" FontSize="11" Margin="2,0,4,0"
                                           Foreground="{StaticResource BrandMutedBrush}"/>
                                <Button x:Name="CloneBrushSizeMinusButton" Content="−"
                                        Style="{StaticResource SecondaryButton}" Padding="8,2" MinWidth="28"
                                        ToolTip="Küçült (≥1 → 1; &lt;1 → 0,1)"
                                        Click="CloneBrushSizeMinus_Click"/>
                                <TextBlock x:Name="CloneBrushSizeLabel" Text="4%"
                                           VerticalAlignment="Center" FontSize="11" Margin="4,0,4,0"
                                           Foreground="{StaticResource BrandMutedBrush}" MinWidth="36"
                                           TextAlignment="Center"/>
                                <Button x:Name="CloneBrushSizePlusButton" Content="+"
                                        Style="{StaticResource SecondaryButton}" Padding="8,2" MinWidth="28" Margin="0,0,4,0"
                                        ToolTip="Büyüt (≥1 → 1; &lt;1 → 0,1)"
                                        Click="CloneBrushSizePlus_Click"/>
                                <Slider x:Name="CloneBrushSizeSlider" Width="72" Height="26"
                                        Minimum="0.1" Maximum="20" Value="4" VerticalAlignment="Center"
                                        ToolTip="Fırça boyutu (%). 1 altında 0,1; 1 ve üstünde 1 adım"
                                        ValueChanged="CloneBrushSizeSlider_Changed"/>
                                <ToggleButton x:Name="FiligramBrushModeToggle" Content="Filigram fırça"
                                              Padding="10,4" Margin="8,0,4,0"
                                              ToolTip="Şekil + Boyut ile filigram alanı seç. Hover: önizleme, tık: temizle."
                                              Checked="FiligramBrushModeToggle_Changed"
                                              Unchecked="FiligramBrushModeToggle_Changed"/>
                                <Button x:Name="CleanCornerWatermarkButton" Content="Filigram temizle"
                                        Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,4,0"
                                        ToolTip="Fırça merkezi / pin / dikdörtgen seçimine göre temizler"
                                        Click="CleanCornerWatermarkButton_Click"/>
                                <Button x:Name="FiligramCleanUndoButton" Content="Filigram ↶"
                                        Style="{StaticResource SecondaryButton}" Padding="8,4"
                                        ToolTip="Son filigram temizliğini geri al"
                                        Click="FiligramCleanUndoButton_Click" IsEnabled="False"/>
                                <ToggleButton x:Name="CloneStampModeToggle" Content="Klon"
                                              Padding="10,4" Margin="12,0,4,0"
                                              ToolTip="1) Sol tık: kaynak. 2) Sol tık/sürükle: damga. Şekil/Boyut ortaktır."
                                              Checked="CloneStampModeToggle_Changed"
                                              Unchecked="CloneStampModeToggle_Changed"/>
                                <Button x:Name="ClonePickSourceButton" Content="Kaynak al"
                                        Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,4,0"
                                        MinWidth="108"
                                        ToolTip="Sonraki sol tık yeni kaynak olur. Sağ tık da kaynağı seçer."
                                        Click="ClonePickSourceButton_Click"/>
                                <Button x:Name="CloneUndoButton" Content="Klon ↶"
                                        Style="{StaticResource SecondaryButton}" Padding="8,4"
                                        ToolTip="Son klon damgasını geri al"
                                        Click="CloneUndoButton_Click" IsEnabled="False"/>
                                <TextBlock x:Name="CloneStatusHint" Text=""
                                           VerticalAlignment="Center" FontSize="11" Margin="8,0,0,0"
                                           Foreground="#0A7EA4" FontWeight="SemiBold"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button x:Name="PreviewZoomOutButton" Content="🔍−"
                                        Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="0,0,2,0"
                                        ToolTip="Uzaklaştır (Ctrl + tekerlek)"
                                        Click="PreviewZoomOut_Click"/>
                                <Button x:Name="PreviewZoomInButton" Content="🔍+"
                                        Style="{StaticResource SecondaryButton}" Padding="6,4" Margin="0,0,2,0"
                                        ToolTip="Yakınlaştır (Ctrl + tekerlek)"
                                        Click="PreviewZoomIn_Click"/>
                                <Button x:Name="PreviewZoomResetButton" Content="100%"
                                        Style="{StaticResource SecondaryButton}" Padding="8,4" MinWidth="52"
                                        ToolTip="Varsayılan yakınlaştırma (Ctrl + 0) · Ctrl+tekerlek: zoom"
                                        Click="PreviewZoomReset_Click"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="En" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{StaticResource BrandMutedBrush}"/>
                            <TextBox x:Name="CropWidthPxBox" Width="64" Height="26" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="Seçim genişliği (px)"
                                     LostFocus="CropPxBox_LostFocus" KeyDown="CropPxBox_KeyDown"/>
                            <TextBlock Text="Boy" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{StaticResource BrandMutedBrush}"/>
                            <TextBox x:Name="CropHeightPxBox" Width="64" Height="26" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center" Padding="4,0"
                                     ToolTip="Seçim yüksekliği (px)"
                                     LostFocus="CropPxBox_LostFocus" KeyDown="CropPxBox_KeyDown"/>
                            <Button Content="−" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,2,0"
                                    ToolTip="Seçimi 1 px daralt" Click="CropShrink_Click"/>
                            <Button Content="+" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,0"
                                    ToolTip="Seçimi 1 px genişlet" Click="CropGrow_Click"/>
                            <Button Content="En −" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="Genişliği 1 px azalt" Click="CropShrinkWidth_Click"/>
                            <Button Content="En +" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                    ToolTip="Genişliği 1 px artır" Click="CropGrowWidth_Click"/>
                            <Button Content="Boy −" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="Yüksekliği 1 px azalt" Click="CropShrinkHeight_Click"/>
                            <Button Content="Boy +" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,10,0"
                                    ToolTip="Yüksekliği 1 px artır" Click="CropGrowHeight_Click"/>
                            <Button Content="4:3" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,2,0"
                                    ToolTip="Görsele sığan en büyük 4:3 seçimi (ortalanmış)" Click="CropAspect43_Click"/>
                            <Button Content="4:4" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,2,0"
                                    ToolTip="Görsele sığan en büyük 4:4 (kare) seçimi (ortalanmış)" Click="CropAspect44_Click"/>
                            <Button Content="4:5" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,10,0"
                                    ToolTip="Görsele sığan en büyük 4:5 seçimi (ortalanmış)" Click="CropAspect45_Click"/>
                            <Button Content="◀" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="1 px sola kaydır" Click="CropAlignLeft_Click"/>
                            <Button Content="●" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="Yatay ortala" Click="CropAlignCenterH_Click"/>
                            <Button Content="▶" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,8,0"
                                    ToolTip="1 px sağa kaydır" Click="CropAlignRight_Click"/>
                            <Button Content="▲" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="1 px yukarı kaydır" Click="CropAlignTop_Click"/>
                            <Button Content="◆" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="Dikey ortala" Click="CropAlignCenterV_Click"/>
                            <Button Content="▼" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,10,0"
                                    ToolTip="1 px aşağı kaydır" Click="CropAlignBottom_Click"/>
                            <Button x:Name="CropApplyButton" Content="Dışını kırp"
                                    Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,4,0"
                                    Click="CropApply_Click" IsEnabled="False"
                                    ToolTip="Seçimin dışını atar; seçili alanı tutar (klasik kırpma)"/>
                            <Button x:Name="CropInteriorButton" Content="İçini kırp"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,0,4,0"
                                    Click="CropInterior_Click" IsEnabled="False"
                                    ToolTip="Seçimin içindeki içeriği temizler (zemin onarımı) — boyut aynı kalır"/>
                            <Button x:Name="TextureFillSelectionButton" Content="Doku nakli"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0,0,6,0"
                                    Click="TextureFillSelection_Click" IsEnabled="False"
                                    ToolTip="Önce Kaynak al, sonra seçime doku aktarır"/>
                            <Button x:Name="SelectionCopyButton" Content="Kopyala"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,2,0"
                                    Click="SelectionCopyButton_Click" IsEnabled="False"
                                    ToolTip="Seçimi panoya kopyala (isteğe bağlı)"/>
                            <Button x:Name="SelectionPasteButton" Content="Bırak / Döndür"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,2,0"
                                    Click="SelectionPasteButton_Click" IsEnabled="False"
                                    ToolTip="Şekil seçimini doğrudan al · sürükle · tekerlek döndür · çift tık / Enter bırak"/>
                            <Button x:Name="SelectionRotateLeftButton" Content="↺"
                                    Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="0,0,2,0"
                                    Click="SelectionRotateLeft_Click" IsEnabled="False"
                                    ToolTip="Sola döndür (−5°)"/>
                            <Button x:Name="SelectionRotateRightButton" Content="↻"
                                    Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="0,0,6,0"
                                    Click="SelectionRotateRight_Click" IsEnabled="False"
                                    ToolTip="Sağa döndür (+5°)"/>
                            <Button x:Name="CropUndoButton" Content="↶ Geri al"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"
                                    Click="CropUndo_Click" IsEnabled="False"/>
                            <Button x:Name="CropClearButton" Content="✕ Seçim"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,4,0"
                                    Click="CropClear_Click" IsEnabled="False"
                                    ToolTip="Bekleyen seçim / pin / fırça çerçevesini temizle (uygulanan kırpmayı da siler)"/>
                            <Button x:Name="RestoreLastSelectionButton" Content="Seçim ↶"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"
                                    Click="RestoreLastSelectionButton_Click" IsEnabled="False"
                                    ToolTip="Son kaldırılan seçimi / pinleri geri getir"/>
                            <Button x:Name="ResetAllPhotoEditsButton" Content="⟲ Tümünü sıfırla"
                                    Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,12,0"
                                    Click="ResetAllPhotoEditsButton_Click" IsEnabled="False"
                                    ToolTip="Bu görsele uygulanan kırp, filigram, klon ve seçimleri tamamen sıfırlar"/>
                            <ToggleButton x:Name="PinSelectModeToggle" Content="📌 Pin seçim"
                                          Padding="10,4" Margin="0,0,4,0"
                                          ToolTip="Sol tık: pin koy (max 20). Sağ tık: son pini sil. 2 pin=çizgi, 3+=çokgen."
                                          Checked="PinSelectModeToggle_Changed"
                                          Unchecked="PinSelectModeToggle_Changed"/>
                            <Button x:Name="PinUndoButton" Content="Pin ↶"
                                    Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,2,0"
                                    ToolTip="Son pini sil"
                                    Click="PinUndoButton_Click" IsEnabled="False"/>
                            <Button x:Name="PinClearButton" Content="Pinleri sil"
                                    Style="{StaticResource SecondaryButton}" Padding="8,4"
                                    ToolTip="Tüm pinleri temizle"
                                    Click="PinClearButton_Click" IsEnabled="False"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Sahne: Ctrl+tekerlek ile yakınlaştırma -->
                    <Border Grid.Row="1" Background="#ECEFF4" CornerRadius="8"
                            BorderBrush="#D0D5DE" BorderThickness="1" ClipToBounds="True">
                        <ScrollViewer x:Name="PreviewScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      Focusable="True"
                                      PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel"
                                      SizeChanged="PreviewScrollViewer_SizeChanged">
                            <Grid x:Name="PreviewZoomHost" Background="Transparent">
                                <TextBlock x:Name="PreviewPlaceholderText"
                                           Text="Önizleme hazırlanıyor…"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrandMutedBrush}" FontSize="14"/>
                                <Image x:Name="LivePreviewImage" Stretch="Uniform"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       Margin="8" Visibility="Collapsed"
                                       MouseLeftButtonDown="LivePreviewImage_MouseLeftButtonDown"
                                       MouseRightButtonDown="LivePreviewImage_MouseRightButtonDown"
                                       MouseMove="LivePreviewImage_MouseMove"
                                       MouseLeftButtonUp="LivePreviewImage_MouseLeftButtonUp"
                                       Cursor="Arrow"/>
                                <Canvas x:Name="PreviewPinCanvas"
                                        IsHitTestVisible="False"/>
                                <Canvas x:Name="PreviewCloneCanvas"
                                        IsHitTestVisible="False"/>
                                <Image x:Name="FloatingPasteImage"
                                       Visibility="Collapsed"
                                       Stretch="Fill"
                                       IsHitTestVisible="False"
                                       Opacity="0.92"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform x:Name="FloatingPasteRotate"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                                <Grid x:Name="PreviewCropSelectionRect"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      IsHitTestVisible="False">
                                    <Rectangle Fill="#18000000"
                                               Stroke="#B3000000"
                                               StrokeThickness="1"
                                               StrokeDashArray="2,2"
                                               SnapsToDevicePixels="True"
                                               UseLayoutRounding="True"/>
                                    <Rectangle Fill="Transparent"
                                               Stroke="#F2FFFFFF"
                                               StrokeThickness="1"
                                               StrokeDashArray="2,2"
                                               StrokeDashOffset="2"
                                               SnapsToDevicePixels="True"
                                               UseLayoutRounding="True"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Boyut / durum satırı -->
                    <Grid Grid.Row="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewSizeText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="PreviewCaptionText" FontSize="10"
                                   Foreground="{StaticResource BrandMutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" x:Name="PreviewErrorText"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="#B42318" Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10"
                    Padding="8,8,8,8" BorderBrush="#E2E6ED" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="İşlem günlüğü" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" Background="#F8F9FB" CornerRadius="6" BorderBrush="#E2E6ED" BorderThickness="1"
                            Padding="4">
                        <ListBox x:Name="LogList" BorderThickness="0" Background="Transparent"
                                 FontFamily="Consolas" FontSize="10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Alt: Ayarlar (iki sütun, kaydırılabilir) -->
        <Border Grid.Row="3" Background="White" CornerRadius="10"
                Padding="14,12,14,12" BorderBrush="#E2E6ED" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚙" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ayarlar" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profil" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="PresetCombo" Grid.Column="1" DisplayMemberPath="Name" Height="30"
                                  SelectionChanged="PresetCombo_SelectionChanged" Margin="0,0,6,0"/>
                        <TextBox x:Name="PresetNameBox" Grid.Column="2" Height="30"
                                 VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,6,0"
                                 ToolTip="Profil adı"/>
                        <Button x:Name="SavePresetButton" Grid.Column="3" Content="💾 Kaydet"
                                Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0"
                                Click="SavePreset_Click"/>
                        <Button Grid.Column="4" Content="Sil" Style="{StaticResource SecondaryButton}"
                                Padding="10,5" Click="DeletePreset_Click"/>
                    </Grid>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sol: Şablon + Renk + Marka -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,8,12">
                        <StackPanel>
                            <TextBlock Text="Şablon" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TemplateCombo" DisplayMemberPath="Name"
                                          SelectionChanged="TemplateCombo_SelectionChanged"
                                          Height="32"/>
                                <Button x:Name="FavoriteTemplateButton" Grid.Column="1" Content="☆"
                                        Margin="6,0,0,0" Padding="10,4" ToolTip="Favoriye ekle / çıkar"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="FavoriteTemplate_Click"/>
                            </Grid>
                            <TextBlock x:Name="TemplateDescription" TextWrapping="Wrap" MaxHeight="36"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrandMutedBrush}"
                                       FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ResponsiveProductFitCheck"
                                      Content="Responsif sığdır (boşlukları doldur, kenarlar kırpılabilir)"
                                      Margin="0,0,0,10" FontSize="11"
                                      Checked="AdvancedOption_Changed" Unchecked="AdvancedOption_Changed"/>

                            <!-- Renk: üstte ve vurgulu kart -->
                            <Border x:Name="ColorSettingsPanel" Background="#F8F9FB" CornerRadius="8" Padding="12,10"
                                    BorderBrush="#D8DEE8" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Renk paketi" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ColorPackCombo" DisplayMemberPath="Name"
                                              SelectionChanged="ColorPackCombo_SelectionChanged"
                                              Height="32" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ColorPackDescription" TextWrapping="Wrap" MaxHeight="32"
                                               Foreground="{StaticResource BrandMutedBrush}"
                                               FontSize="11" Margin="0,0,0,8"/>

                                    <TextBlock x:Name="ColorFieldsHintText"
                                               FontSize="10" Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                    <TextBlock x:Name="EyedropperHintText" Visibility="Collapsed"
                                               FontSize="10" FontWeight="SemiBold" Foreground="#0A6EBD"
                                               Margin="0,0,0,6" TextWrapping="Wrap"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BackgroundColorLabel" Text="Zemin" Style="{StaticResource FieldLabel}"/>
                                        <Border x:Name="BackgroundColorPreview" Grid.Column="1" Height="28" Width="32"
                                                CornerRadius="4" BorderBrush="#D0D5DE" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonUp="PickBackgroundColor_Click"/>
                                        <TextBox x:Name="BackgroundColorHexBox" Grid.Column="2" Height="28"
                                                 FontFamily="Consolas" FontSize="11" Margin="6,0,6,0"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Tag="Background" KeyDown="ColorInputBox_KeyDown" LostFocus="ColorInputBox_LostFocus"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="Damla" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,5" MinWidth="44" Margin="0,0,4,0"
                                                    Tag="Background" ToolTip="Önizleme görselinden renk al (damla)"
                                                    Click="EyedropColor_Click"/>
                                            <Button x:Name="PickBackgroundColorButton"
                                                    Content="Seç…" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,5" MinWidth="48" Click="PickBackgroundColor_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MainTextColorLabel" Text="Ana metin" Style="{StaticResource FieldLabel}"/>
                                        <Border x:Name="RonekaiColorPreview" Grid.Column="1" Height="28" Width="32"
                                                CornerRadius="4" BorderBrush="#D0D5DE" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonUp="PickRonekaiColor_Click"/>
                                        <TextBox x:Name="RonekaiColorHexBox" Grid.Column="2" Height="28"
                                                 FontFamily="Consolas" FontSize="11" Margin="6,0,6,0"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Tag="MainText" KeyDown="ColorInputBox_KeyDown" LostFocus="ColorInputBox_LostFocus"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="Damla" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,5" MinWidth="44" Margin="0,0,4,0"
                                                    Tag="MainText" ToolTip="Önizleme görselinden renk al (damla)"
                                                    Click="EyedropColor_Click"/>
                                            <Button x:Name="PickRonekaiColorButton"
                                                    Content="Seç…" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,5" MinWidth="48" Click="PickRonekaiColor_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SuffixColorLabel" Text="Ek metin" Style="{StaticResource FieldLabel}"/>
                                        <Border x:Name="DenColorPreview" Grid.Column="1" Height="28" Width="32"
                                                CornerRadius="4" BorderBrush="#D0D5DE" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonUp="PickDenColor_Click"/>
                                        <TextBox x:Name="DenColorHexBox" Grid.Column="2" Height="28"
                                                 FontFamily="Consolas" FontSize="11" Margin="6,0,6,0"
                                                 VerticalContentAlignment="Center" Padding="6,0"
                                                 Tag="Suffix" KeyDown="ColorInputBox_KeyDown" LostFocus="ColorInputBox_LostFocus"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="Damla" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,5" MinWidth="44" Margin="0,0,4,0"
                                                    Tag="Suffix" ToolTip="Önizleme görselinden renk al (damla)"
                                                    Click="EyedropColor_Click"/>
                                            <Button x:Name="PickDenColorButton"
                                                    Content="Seç…" Style="{StaticResource SecondaryButton}"
                                                    Padding="8,5" MinWidth="48" Click="PickDenColor_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Expander Header="Opaklık ve gradyan" Margin="0,8,0,0" IsExpanded="False">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="Zemin" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tür" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="BackgroundFillModeCombo" Grid.Column="1" Height="26" Margin="4,0,4,0"
                                                          SelectionChanged="ColorAppearance_Changed"/>
                                                <TextBlock x:Name="BackgroundOpacityLabel" Grid.Column="2" VerticalAlignment="Center" FontSize="10"/>
                                            </Grid>
                                            <Slider x:Name="BackgroundOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                                    TickFrequency="10" IsSnapToTickEnabled="False"
                                                    ValueChanged="ColorAppearanceSlider_Changed" Margin="0,0,0,4"/>
                                            <Grid x:Name="BackgroundGradientPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Gradyan" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="BackgroundGradientEndHexBox" Grid.Column="1" Height="26"
                                                         FontFamily="Consolas" FontSize="10" Margin="4,0,4,0"
                                                         Tag="Background" KeyDown="GradientEndBox_KeyDown" LostFocus="GradientEndBox_LostFocus"/>
                                                <ComboBox x:Name="BackgroundGradientDirectionCombo" Grid.Column="2" Width="88" Height="26"
                                                          SelectionChanged="ColorAppearance_Changed"/>
                                            </Grid>

                                            <TextBlock Text="Ana metin" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,4"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tür" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="MainTextFillModeCombo" Grid.Column="1" Height="26" Margin="4,0,4,0"
                                                          SelectionChanged="ColorAppearance_Changed"/>
                                                <TextBlock x:Name="MainTextOpacityLabel" Grid.Column="2" VerticalAlignment="Center" FontSize="10"/>
                                            </Grid>
                                            <Slider x:Name="MainTextOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                                    ValueChanged="ColorAppearanceSlider_Changed" Margin="0,0,0,4"/>
                                            <Grid x:Name="MainTextGradientPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Gradyan" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="MainTextGradientEndHexBox" Grid.Column="1" Height="26"
                                                         FontFamily="Consolas" FontSize="10" Margin="4,0,4,0"
                                                         Tag="MainText" KeyDown="GradientEndBox_KeyDown" LostFocus="GradientEndBox_LostFocus"/>
                                                <ComboBox x:Name="MainTextGradientDirectionCombo" Grid.Column="2" Width="88" Height="26"
                                                          SelectionChanged="ColorAppearance_Changed"/>
                                            </Grid>

                                            <TextBlock Text="Ek metin" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,4"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="56"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tür" Style="{StaticResource FieldLabel}"/>
                                                <ComboBox x:Name="SuffixFillModeCombo" Grid.Column="1" Height="26" Margin="4,0,4,0"
                                                          SelectionChanged="ColorAppearance_Changed"/>
                                                <TextBlock x:Name="SuffixOpacityLabel" Grid.Column="2" VerticalAlignment="Center" FontSize="10"/>
                                            </Grid>
                                            <Slider x:Name="SuffixOpacitySlider" Minimum="0" Maximum="100" Value="100"
                                                    ValueChanged="ColorAppearanceSlider_Changed" Margin="0,0,0,4"/>
                                            <Grid x:Name="SuffixGradientPanel" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Gradyan" Style="{StaticResource FieldLabel}"/>
                                                <TextBox x:Name="SuffixGradientEndHexBox" Grid.Column="1" Height="26"
                                                         FontFamily="Consolas" FontSize="10" Margin="4,0,4,0"
                                                         Tag="Suffix" KeyDown="GradientEndBox_KeyDown" LostFocus="GradientEndBox_LostFocus"/>
                                                <ComboBox x:Name="SuffixGradientDirectionCombo" Grid.Column="2" Width="88" Height="26"
                                                          SelectionChanged="ColorAppearance_Changed"/>
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="RGB değerleri (isteğe bağlı)" Margin="0,8,0,0" IsExpanded="False">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBox x:Name="BackgroundColorRgbBox" Height="26" FontFamily="Consolas" FontSize="10"
                                                     VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,4"
                                                     Tag="Background" KeyDown="ColorInputBox_KeyDown" LostFocus="ColorInputBox_LostFocus"/>
                                            <TextBox x:Name="RonekaiColorRgbBox" Height="26" FontFamily="Consolas" FontSize="10"
                                                     VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,4"
                                                     Tag="MainText" KeyDown="ColorInputBox_KeyDown" LostFocus="ColorInputBox_LostFocus"/>
                                            <TextBox x:Name="DenColorRgbBox" Height="26" FontFamily="Consolas" FontSize="10"
                                                     VerticalContentAlignment="Center" Padding="6,0"
                                                     Tag="Suffix" KeyDown="ColorInputBox_KeyDown" LostFocus="ColorInputBox_LostFocus"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Görseldeki marka" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Önizleme ve çıktıdaki metin / logo"
                                       FontSize="11" Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ana metin" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ImageBrandMainBox" Grid.Column="1" Height="28"
                                         VerticalContentAlignment="Center" Padding="6,0"
                                         TextChanged="ImageBrand_TextChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ek / son ek" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox x:Name="ImageBrandSuffixBox" Grid.Column="1" Height="28"
                                         VerticalContentAlignment="Center" Padding="6,0"
                                         TextChanged="ImageBrand_TextChanged"/>
                                <Button Grid.Column="2" Content="Başlıktan al" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Padding="8,4"
                                        Click="CopyBrandFromHeader_Click"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ana font" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="BrandMainFontCombo" Grid.Column="1" Height="28"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="BrandFont_Changed"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ek font" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="BrandSuffixFontCombo" Grid.Column="1" Height="28"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="BrandFont_Changed"/>
                            </Grid>

                            <CheckBox x:Name="ShowImageBrandMainCheck" Content="Ana metni göster"
                                      Margin="0,8,0,4"
                                      Checked="ImageBrandVisibility_Changed" Unchecked="ImageBrandVisibility_Changed"/>
                            <TextBlock Text="Ana metin boyutu" FontSize="10"
                                       Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ImageBrandMainSizeSlider" Minimum="50" Maximum="200" Value="100"
                                        VerticalAlignment="Center"
                                        ValueChanged="ImageBrandSize_Changed"/>
                                <TextBlock x:Name="ImageBrandMainSizeLabel" Grid.Column="1" Text="100%"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource BrandMutedBrush}"/>
                            </Grid>

                            <CheckBox x:Name="ShowImageBrandSuffixCheck" Content="Ek / son metni göster"
                                      Margin="0,0,0,4"
                                      Checked="ImageBrandVisibility_Changed" Unchecked="ImageBrandVisibility_Changed"/>
                            <TextBlock Text="Ek metin boyutu" FontSize="10"
                                       Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,2"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="ImageBrandSuffixSizeSlider" Minimum="50" Maximum="200" Value="100"
                                        VerticalAlignment="Center"
                                        ValueChanged="ImageBrandSize_Changed"/>
                                <TextBlock x:Name="ImageBrandSuffixSizeLabel" Grid.Column="1" Text="100%"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{StaticResource BrandMutedBrush}"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <Rectangle Grid.Column="1" Width="1" Fill="#E2E6ED" HorizontalAlignment="Center"/>

                    <!-- Sağ: Logo + Klasör -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Logo" Style="{StaticResource SectionTitle}"/>
                            <ComboBox x:Name="LogoModeCombo" DisplayMemberPath="Name"
                                      SelectionChanged="LogoModeCombo_SelectionChanged"
                                      Height="32" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LogoModeDescription" TextWrapping="Wrap"
                                       Foreground="{StaticResource BrandMutedBrush}"
                                       FontSize="12" Margin="0,0,0,8"/>

                            <CheckBox x:Name="UseDefaultLogoCheck" Content="Varsayılan logo" Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LogoPathBox" Height="30" VerticalContentAlignment="Center"
                                         Padding="8,0" IsReadOnly="True"
                                         Background="{StaticResource BrandLightBrush}" BorderBrush="#D0D5DE"/>
                                <Button x:Name="BrowseLogoButton" Grid.Column="1" Content="Logo seç…"
                                        Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" IsEnabled="False" Click="BrowseLogo_Click"/>
                            </Grid>
                            <TextBlock x:Name="LogoFormatLabel" FontSize="11"
                                       Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Yoğunluk" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <Slider x:Name="LogoOpacitySlider" Grid.Column="1"
                                        Minimum="5" Maximum="100" Value="35"
                                        Margin="8,0" VerticalAlignment="Center" IsEnabled="False"
                                        ValueChanged="LogoOverlayOption_Changed"/>
                                <TextBlock x:Name="LogoOpacityLabel" Grid.Column="2" Text="35%"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource BrandMutedBrush}"/>
                            </Grid>

                            <StackPanel x:Name="FiligranOptionsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                                <TextBlock Text="Filigran konumu" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="LogoPlacementCombo" Height="28" Margin="0,0,0,6"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="LogoOverlayOption_Changed"/>
                                <TextBlock Text="Filigran boyutu" FontSize="10"
                                           Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="LogoScaleSlider" Minimum="20" Maximum="90" Value="62"
                                            VerticalAlignment="Center"
                                            ValueChanged="LogoOverlayOption_Changed"/>
                                    <TextBlock x:Name="LogoScaleLabel" Grid.Column="1" Text="62%"
                                               VerticalAlignment="Center" FontSize="11"
                                               Foreground="{StaticResource BrandMutedBrush}"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Kaynak klasör" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="JPG, PNG, WEBP, HEIC — sürükle-bırak veya Gözat"
                                       FontSize="11" Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,6"/>
                            <Border x:Name="SourceDropZone" Margin="0,0,0,6" CornerRadius="6"
                                    BorderBrush="#D0D5DE" BorderThickness="1" Background="#FAFBFC"
                                    AllowDrop="True" DragOver="SourceDropZone_DragOver" Drop="SourceDropZone_Drop">
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SourceFolderBox" Height="30" VerticalContentAlignment="Center"
                                             Padding="8,0" Background="Transparent" BorderThickness="0"
                                             TextChanged="SourceFolderBox_TextChanged"/>
                                    <Button Grid.Column="1" Content="Gözat…" Margin="8,4,4,4"
                                            Style="{StaticResource SecondaryButton}" Padding="10,6"
                                            Click="BrowseSource_Click"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Alt klasör" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SourceSubfolderCombo" Height="28" Margin="0,0,0,10"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="SourceSubfolderCombo_SelectionChanged"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dosya listesi (Ctrl ile çoklu seçim)" FontSize="11"
                                           Foreground="{StaticResource BrandMutedBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Yenile" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Padding="8,3"
                                        Click="RefreshFileList_Click"/>
                                <Button Grid.Column="2" Content="Tümü" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButton}" Padding="8,3"
                                        Click="SelectAllFiles_Click"/>
                            </Grid>
                            <CheckBox x:Name="ProcessSelectedOnlyCheck"
                                      Content="Seçili dosyaları işle (kapalıyken klasörün tamamı)"
                                      Margin="0,0,0,2"
                                      Checked="ProcessSelectedOnlyCheck_Changed" Unchecked="ProcessSelectedOnlyCheck_Changed"/>
                            <TextBlock x:Name="ProcessSelectionHint" TextWrapping="Wrap" FontSize="10"
                                       Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,4"/>
                            <Border Background="#F8F9FB" CornerRadius="6" BorderBrush="#E2E6ED" BorderThickness="1"
                                    MaxHeight="120" Margin="0,0,0,12">
                                <ListBox x:Name="SourceFileList" BorderThickness="0" Background="Transparent"
                                         FontSize="11" SelectionMode="Extended"
                                         SelectionChanged="SourceFileList_SelectionChanged"
                                         PreviewMouseLeftButtonDown="SourceFileList_PreviewMouseLeftButtonDown"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <Border x:Name="BrandLogoPanel" Background="#F8F9FB" CornerRadius="8"
                                    Padding="10,8" BorderBrush="#D8DEE8" BorderThickness="1" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Marka logosu" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="BrandLogoScopeHint" TextWrapping="Wrap" FontSize="10"
                                               Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ShowBrandLogoCheck" Content="Marka logosunu göster"
                                              Margin="0,0,0,6"
                                              Checked="BrandLogoUi_Changed" Unchecked="BrandLogoUi_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Button Content="Beyaz (filigram-08)"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Click="BrandLogoWhitePreset_Click"/>
                                        <Button Content="Siyah (filigram-09)"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Click="BrandLogoBlackPreset_Click"/>
                                        <Button Content="Yatay beyaz"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Click="BrandLogoHorizontalWhitePreset_Click"/>
                                        <Button Content="Yatay siyah"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0"
                                                Click="BrandLogoHorizontalBlackPreset_Click"/>
                                        <Button x:Name="BrowseBrandLogoButton" Content="Logo seç…"
                                                Style="{StaticResource SecondaryButton}" Padding="8,4"
                                                Click="BrowseBrandLogo_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="BrandLogoPathBox" Height="26" IsReadOnly="True"
                                             VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,6"
                                             FontSize="10"/>
                                    <TextBlock x:Name="BrandLogoSelectedHint" TextWrapping="Wrap" FontSize="10"
                                               Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Konum" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="BrandLogoPlacementCombo" Height="28" Margin="0,0,0,6"
                                              DisplayMemberPath="Name"
                                              SelectionChanged="BrandLogoUi_Changed"/>
                                    <TextBlock Text="Konum ince ayarı" FontSize="10"
                                               Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider x:Name="BrandLogoOffsetXSlider" Grid.Column="1" Minimum="-150" Maximum="150" Value="0"
                                                ToolTip="Yatay kaydırma (px, çıktı boyutu)"/>
                                        <TextBlock x:Name="BrandLogoOffsetXLabel" Grid.Column="2" Text="0"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource BrandMutedBrush}"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Y" VerticalAlignment="Center" FontSize="11"/>
                                        <Slider x:Name="BrandLogoOffsetYSlider" Grid.Column="1" Minimum="-150" Maximum="150" Value="0"
                                                ToolTip="Dikey kaydırma (px, çıktı boyutu)"/>
                                        <TextBlock x:Name="BrandLogoOffsetYLabel" Grid.Column="2" Text="0"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource BrandMutedBrush}"/>
                                    </Grid>
                                    <TextBlock Text="Logo boyutu" FontSize="10"
                                               Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BrandLogoSizeSlider" Minimum="25" Maximum="200" Value="100"/>
                                        <TextBlock x:Name="BrandLogoSizeLabel" Grid.Column="1" Text="100%"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource BrandMutedBrush}"/>
                                    </Grid>
                                    <TextBlock Text="Şeffaflık" FontSize="10"
                                               Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BrandLogoOpacitySlider" Minimum="5" Maximum="100" Value="100"/>
                                        <TextBlock x:Name="BrandLogoOpacityLabel" Grid.Column="1" Text="100%"
                                                   VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{StaticResource BrandMutedBrush}"/>
                                    </Grid>
                                    <CheckBox x:Name="BrandLogoTintEnabledCheck" Content="Renk filtresi uygula"
                                              Margin="0,0,0,6"
                                              Checked="BrandLogoUi_Changed" Unchecked="BrandLogoUi_Changed"/>
                                    <StackPanel x:Name="BrandLogoTintPanel" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="BrandLogoTintPreview" Height="28" Width="32"
                                                    CornerRadius="4" BorderBrush="#D0D5DE" BorderThickness="1" Cursor="Hand"
                                                    MouseLeftButtonUp="PickBrandLogoTint_Click"/>
                                            <TextBox x:Name="BrandLogoTintHexBox" Grid.Column="1" Height="28"
                                                     FontFamily="Consolas" FontSize="11" Margin="6,0,6,0"
                                                     VerticalContentAlignment="Center" Padding="6,0"
                                                     Tag="BrandLogoTint" KeyDown="BrandLogoTintHexBox_KeyDown"
                                                     LostFocus="BrandLogoTintHexBox_LostFocus"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="Damla" Style="{StaticResource SecondaryButton}"
                                                        Padding="8,5" MinWidth="44" Margin="0,0,4,0"
                                                        Tag="BrandLogoTint" ToolTip="Önizlemeden renk al"
                                                        Click="EyedropColor_Click"/>
                                                <Button Content="Seç…" Style="{StaticResource SecondaryButton}"
                                                        Padding="8,5" MinWidth="48" Click="PickBrandLogoTint_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Dolgu" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="BrandLogoTintFillModeCombo" Grid.Column="1" Height="26" Margin="4,0,4,0"
                                                      SelectionChanged="BrandLogoTintAppearance_Changed"/>
                                            <TextBlock Grid.Column="2" Text="Yoğunluk" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="BrandLogoTintOpacitySlider" Minimum="5" Maximum="100" Value="100"/>
                                            <TextBlock x:Name="BrandLogoTintOpacityLabel" Grid.Column="1" Text="100%"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{StaticResource BrandMutedBrush}"/>
                                        </Grid>
                                        <Grid x:Name="BrandLogoTintGradientPanel" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Gradyan son" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                            <TextBox x:Name="BrandLogoTintGradientEndHexBox" Grid.Column="1" Height="26"
                                                     FontFamily="Consolas" FontSize="11" Margin="4,0,4,0"
                                                     Tag="BrandLogoTintEnd" KeyDown="BrandLogoTintHexBox_KeyDown"
                                                     LostFocus="BrandLogoTintHexBox_LostFocus"/>
                                            <ComboBox x:Name="BrandLogoTintGradientDirectionCombo" Grid.Column="2" Width="88" Height="26"
                                                      SelectionChanged="BrandLogoTintAppearance_Changed"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="ApplyBrandLogoToAllButton" Content="Bu ayarı tüm dosyalara uygula"
                                            Style="{StaticResource SecondaryButton}" Padding="8,5"
                                            Click="ApplyBrandLogoToAll_Click"/>
                                </StackPanel>
                            </Border>

                            <Expander Header="Gelişmiş ayarlar" IsExpanded="False" Margin="0,0,0,12">
                                <StackPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="ResizeOnlyCheck" Content="Sadece boyutlandır (şablon uygulanmaz)"
                                              Margin="0,0,0,8" Checked="AdvancedOption_Changed" Unchecked="AdvancedOption_Changed"/>

                                    <TextBlock Text="JPEG kalitesi" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="JpegQualitySlider" Minimum="50" Maximum="100" Value="92"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="JpegQualityLabel" Grid.Column="1" Text="92"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource BrandMutedBrush}"/>
                                    </Grid>

                                    <TextBlock Text="Çıktı dosya formatı" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="OutputFormatCombo" Height="28" Margin="0,0,0,4"
                                              SelectionChanged="OutputFormatCombo_SelectionChanged"/>
                                    <TextBlock Text="PNG, AVIF, WEBP kaynaklar da işlenir; varsayılan çıktı JPEG (.jpg)."
                                               FontSize="10" Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="SaveAsPngCheck" Content="PNG olarak kaydet (JPEG yerine)"
                                              Visibility="Collapsed"
                                              Checked="AdvancedOption_Changed" Unchecked="AdvancedOption_Changed"/>

                                    <TextBlock Text="Dosya adı şablonu (varsayılan: orijinal ad)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="OutputFileNameBox" Height="28" Margin="0,0,0,4"
                                             VerticalContentAlignment="Center" Padding="6,0"
                                             LostFocus="AdvancedOption_Changed"/>

                                    <CheckBox x:Name="TextOverlayEnabledCheck" Content="Ek metin (fiyat, SKU, kampanya)"
                                              Margin="0,0,0,4" Checked="AdvancedOption_Changed" Unchecked="AdvancedOption_Changed"/>
                                    <TextBox x:Name="TextOverlayTextBox" Height="28" Margin="0,0,0,4"
                                             VerticalContentAlignment="Center" Padding="6,0"
                                             IsEnabled="False" TextChanged="AdvancedOption_Changed"/>
                                    <ComboBox x:Name="TextOverlayPositionCombo" Height="28" Margin="0,0,0,8"
                                              SelectionChanged="AdvancedOption_Changed"/>

                                    <TextBlock Text="İşlem öncesi örnek (0 = kapalı)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SamplePreviewCountBox" Height="28" Margin="0,0,0,4"
                                             VerticalContentAlignment="Center" Padding="6,0" Text="0"
                                             LostFocus="AdvancedOption_Changed"/>
                                    <TextBlock Text="Seçilen sayıda dosya _Onizleme_Ornekleri alt klasörüne işlenir"
                                               FontSize="10" Foreground="{StaticResource BrandMutedBrush}"/>

                                    <Separator Margin="0,10,0,10" Opacity="0.35"/>
                                    <CheckBox x:Name="CropModeCheck"
                                              Content="Kırp modu (önizlemede kes + geri al)"
                                              IsChecked="True"
                                              Visibility="Collapsed"
                                              Margin="0,0,0,6"
                                              Checked="CropModeCheck_Changed"
                                              Unchecked="CropModeCheck_Changed"/>

                                    <!-- Crop kontrolleri artık üst bardadır. -->
                                </StackPanel>
                            </Expander>

                            <TextBlock Text="Çıktı" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="Kaynak klasörün içinde PhonixFrame_tarih_saat klasörü"
                                       FontSize="11" Foreground="{StaticResource BrandMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="OutputPathText" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{StaticResource BrandMutedBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- İlerleme -->
        <StackPanel Grid.Row="4" Margin="0,10,0,8">
            <ProgressBar x:Name="ProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="StatusText" Margin="0,6,0,0"
                       Foreground="{StaticResource BrandMutedBrush}" FontSize="12"/>
        </StackPanel>

        <!-- Alt aksiyonlar -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Çıktı çözünürlüğü / platform" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource BrandPrimaryBrush}" Margin="0,0,10,0"/>
                <ComboBox x:Name="ExportResolutionCombo" Grid.Column="1"
                          DisplayMemberPath="Name" MinWidth="320" Height="32"
                          SelectionChanged="ExportResolutionCombo_SelectionChanged"/>
                <TextBlock x:Name="ExportResolutionHint" Grid.Column="2"
                           VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"
                           Foreground="{StaticResource BrandMutedBrush}" TextWrapping="Wrap" MaxWidth="480"/>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Çıktılar seçili kaynak klasörün içine kaydedilir"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource BrandMutedBrush}"/>
                <Button Grid.Column="1" Content="Çıktıyı Aç" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Padding="14,8"
                        Click="OpenOutput_Click" x:Name="OpenOutputButton" IsEnabled="False"/>
                <Button Grid.Column="2" Content="İptal" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" Padding="14,8"
                        Click="Cancel_Click" x:Name="CancelButton" IsEnabled="False"/>
                <Button Grid.Column="3" Content="Bu klasörü işle"
                        Style="{StaticResource PrimaryButton}" Padding="20,10"
                        Click="Process_Click" x:Name="ProcessButton" MinWidth="160"/>
                <Button Grid.Column="4" Content="Tüm alt klasörleri işle"
                        Style="{StaticResource PrimaryButton}" Padding="20,10"
                        Click="ProcessAllFolders_Click" x:Name="ProcessAllFoldersButton" MinWidth="190"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
