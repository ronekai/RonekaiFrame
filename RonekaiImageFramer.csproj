<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>RonekaiImageFramer</RootNamespace>
    <AssemblyName>PhonixFrame</AssemblyName>
    <Product>PhonixFrame</Product>
    <Description>PhonixFrame — toplu e-ticaret ürün görseli şablonlayıcı</Description>
    <Version>1.0.0</Version>
    <DisableImplicitNamespaceImports_Windows>true</DisableImplicitNamespaceImports_Windows>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
    <PackageReference Include="SixLabors.Fonts" Version="2.1.3" />
    <PackageReference Include="Svg.Skia" Version="3.1.0" />
  </ItemGroup>

</Project>
