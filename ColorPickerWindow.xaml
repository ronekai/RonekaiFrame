<Window x:Class="RonekaiImageFramer.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk seç"
        Height="320" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="PreviewBorder" Grid.Row="0" Height="56" CornerRadius="8"
                BorderBrush="#D0D5DE" BorderThickness="1" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Kırmızı (R)" Margin="0,0,0,4"/>
            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
            <TextBlock Text="Yeşil (G)" Margin="0,12,0,4"/>
            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
            <TextBlock Text="Mavi (B)" Margin="0,12,0,4"/>
            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
            <TextBlock x:Name="HexLabel" Margin="0,16,0,0" FontFamily="Consolas" FontSize="14"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Tamam" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="#1B2A4A" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
