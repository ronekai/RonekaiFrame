<Window x:Class="RonekaiImageFramer.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renk seç — PhonixFrame"
        Height="460" Width="420"
        MinHeight="400" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="PreviewBorder" Grid.Row="0" Height="52" CornerRadius="8"
                BorderBrush="#D0D5DE" BorderThickness="1" Margin="0,0,0,12"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Hex" VerticalAlignment="Center" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="HexBox" Grid.Column="1" Height="28" FontFamily="Consolas"
                     VerticalContentAlignment="Center" Padding="6,0"
                     ToolTip="#F5F6F8 veya F5F6F8"
                     KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>

            <TextBlock Grid.Row="1" Text="RGB" VerticalAlignment="Center" Margin="0,8,0,0"
                       Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="RgbBox" Grid.Row="1" Grid.Column="1" Height="28" FontFamily="Consolas"
                     VerticalContentAlignment="Center" Padding="6,0" Margin="0,8,0,0"
                     ToolTip="245, 246, 248"
                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
        </Grid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Kaydırıcı (isteğe bağlı)" FontSize="11"
                       Foreground="#6B7280" Margin="0,0,0,8"/>
            <TextBlock Text="Kırmızı (R)" Margin="0,0,0,4"/>
            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
            <TextBlock Text="Yeşil (G)" Margin="0,10,0,4"/>
            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
            <TextBlock Text="Mavi (B)" Margin="0,10,0,4"/>
            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="RgbSlider_ValueChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="İptal" Width="90" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Tamam" Width="90" IsDefault="True" Click="Ok_Click"
                    Background="#1B2A4A" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
