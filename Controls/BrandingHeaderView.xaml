<UserControl x:Class="RonekaiImageFramer.Controls.BrandingHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="BrandLogoImage" MaxHeight="28" MaxWidth="110" Margin="0,0,8,0"
               Visibility="Collapsed" Stretch="Uniform"/>
        <StackPanel VerticalAlignment="Center">
            <StackPanel x:Name="BrandTitleRow" Orientation="Horizontal">
                <TextBlock x:Name="BrandMainText" Text="RONEKAI" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource BrandPrimaryBrush}"/>
                <TextBlock x:Name="BrandSuffixText" Text=".DEN" FontSize="11"
                           Foreground="{StaticResource BrandAccentBrush}"
                           VerticalAlignment="Bottom" Margin="2,0,0,1"/>
            </StackPanel>
            <TextBlock x:Name="BrandTaglineText"
                       Text="PhonixFrame — toplu e-ticaret görsel stüdyo"
                       FontSize="10" Foreground="{StaticResource BrandMutedBrush}"
                       Margin="0,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
